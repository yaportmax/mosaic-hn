{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosaichn.org/schema/theme-v1.json",
  "title": "Mosaic HN Theme Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest", "tokens", "layout"],
  "properties": {
    "manifest": {
      "type": "object",
      "required": ["id", "name", "author", "version", "minAppVersion", "license"],
      "properties": {
        "id": {"type":"string","pattern":"^[a-z0-9]+(?:[.-][a-z0-9]+)+$"},
        "name": {"type":"string","minLength":1,"maxLength":60},
        "author": {"type":"string","minLength":1,"maxLength":80},
        "version": {"type":"string"},
        "minAppVersion": {"type":"string"},
        "license": {"type":"string","minLength":1},
        "description": {"type":"string","maxLength":400},
        "homepage": {"type":"string","format":"uri"},
        "preview": {"type":"string"}
      }
    },
    "tokens": {"type":"object","required":["light"],"properties":{"light":{"$ref":"#/$defs/tokens"},"dark":{"$ref":"#/$defs/tokens"},"highContrastLight":{"$ref":"#/$defs/tokens"},"highContrastDark":{"$ref":"#/$defs/tokens"}}},
    "layout": {"type":"object","required":["shell","feed","story","comments","navigation","metadata"],"properties":{"shell":{"enum":["tabs","floating-tabs","sidebar"]},"feed":{"enum":["compact","comfortable","cards","magazine"]},"story":{"enum":["line","row","card","editorial"]},"comments":{"enum":["threads","ledger","conversation"]},"navigation":{"enum":["standard","floating","minimal"]},"metadata":{"enum":["inline","stacked","footer"]}}}
  },
  "$defs": {
    "tokens": {
      "type":"object",
      "required":["colors","typography","spacing","shape","effects","motion"],
      "properties": {
        "colors":{"type":"object"},
        "typography":{"type":"object"},
        "spacing":{"type":"object"},
        "shape":{"type":"object"},
        "effects":{"type":"object"},
        "motion":{"type":"object"}
      }
    }
  }
}
