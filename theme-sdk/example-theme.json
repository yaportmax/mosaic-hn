{
  "manifest": {
    "id": "dev.example.ocean",
    "name": "Ocean",
    "author": "Example theme author",
    "version": "1.0.0",
    "minAppVersion": "1.0.0",
    "license": "MIT",
    "description": "Example community theme package."
  },
  "tokens": {
    "light": {
      "colors": {
        "background": "#EAF8FA",
        "surface": "#FFFFFF",
        "text": "#0C2630",
        "mutedText": "#49646D",
        "accent": "#006F83",
        "border": "#B8D8DD",
        "success": "#16794A",
        "warning": "#8A5A00",
        "danger": "#B42318"
      },
      "typography": {
        "fontFamily": "system",
        "monoFamily": "monospace",
        "scale": 1,
        "titleWeight": "700",
        "bodyWeight": "400"
      },
      "spacing": {
        "unit": 4,
        "density": 1
      },
      "shape": {
        "radius": 14,
        "borderWidth": 1
      },
      "effects": {
        "glass": false,
        "blur": 0,
        "shadow": 0.1
      },
      "motion": {
        "durationScale": 1,
        "springDamping": 18
      }
    },
    "dark": {
      "colors": {
        "background": "#04171C",
        "surface": "#0A252D",
        "text": "#E9FBFF",
        "mutedText": "#A6C8D0",
        "accent": "#4FD8EF",
        "border": "#28505A",
        "success": "#46B97B",
        "warning": "#F5B942",
        "danger": "#FF6B61"
      },
      "typography": {
        "fontFamily": "system",
        "monoFamily": "monospace",
        "scale": 1,
        "titleWeight": "700",
        "bodyWeight": "400"
      },
      "spacing": {
        "unit": 4,
        "density": 1
      },
      "shape": {
        "radius": 14,
        "borderWidth": 1
      },
      "effects": {
        "glass": false,
        "blur": 0,
        "shadow": 0.25
      },
      "motion": {
        "durationScale": 1,
        "springDamping": 18
      }
    }
  },
  "layout": {
    "shell": "tabs",
    "feed": "comfortable",
    "story": "row",
    "comments": "threads",
    "navigation": "standard",
    "metadata": "inline"
  }
}
