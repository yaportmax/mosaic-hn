{
  "name": "mosaic-hn",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "main": "expo-router/entry",
  "type": "module",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "node --experimental-strip-types --test src/core/*.test.ts src/db/*.test.ts src/state/*.test.ts src/design/*.test.ts theme-sdk/*.test.ts",
    "typecheck:core": "tsc -p tsconfig.core.json --noEmit",
    "typecheck:source": "tsc -p tsconfig.source.json --noEmit",
    "lint": "expo lint",
    "validate:themes": "node --experimental-strip-types scripts/validate-themes.ts",
    "verify:source": "node scripts/verify-source.mjs",
    "verify": "npm run test && npm run typecheck:core && npm run typecheck:source && npm run validate:themes && npm run verify:source"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/slider": "5.2.0",
    "@shopify/flash-list": "2.0.2",
    "expo": "~57.0.8",
    "expo-constants": "~57.0.7",
    "expo-crypto": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.8",
    "expo-sharing": "~57.0.7",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "expo-dev-client": "~57.0.9"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~57.0.0",
    "jest-expo": "~57.0.2",
    "prettier": "^3.7.4",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "description": "A local-first, deeply customizable, open-source Hacker News reader.",
  "repository": {
    "type": "git",
    "url": "https://github.com/yaportmax/mosaic-hn.git"
  },
  "bugs": {
    "url": "https://github.com/yaportmax/mosaic-hn/issues"
  },
  "homepage": "https://github.com/yaportmax/mosaic-hn#readme",
  "packageManager": "npm@10.9.2"
}
