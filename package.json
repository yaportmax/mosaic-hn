{
  "name": "mosaic-hn",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "main": "expo-router/entry",
  "type": "module",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node --experimental-strip-types --test src/core/*.test.ts src/db/*.test.ts src/state/*.test.ts src/design/*.test.ts theme-sdk/*.test.ts",
    "typecheck:core": "tsc -p tsconfig.core.json --noEmit",
    "typecheck:source": "tsc -p tsconfig.source.json --noEmit",
    "lint": "expo lint",
    "validate:themes": "node --experimental-strip-types scripts/validate-themes.ts",
    "verify:source": "node scripts/verify-source.mjs",
    "verify": "npm run test && npm run typecheck:core && npm run typecheck:source && npm run validate:themes && npm run verify:source"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/slider": "5.2.0",
    "@shopify/flash-list": "2.0.2",
    "expo": "~56.0.17",
    "expo-constants": "~56.0.22",
    "expo-crypto": "~56.0.4",
    "expo-device": "~56.0.4",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-glass-effect": "~56.0.4",
    "expo-haptics": "~56.0.3",
    "expo-linking": "~56.0.16",
    "expo-network": "~56.0.5",
    "expo-router": "~56.2.16",
    "expo-sharing": "~56.0.23",
    "expo-splash-screen": "~56.0.14",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~56.0.4",
    "jest-expo": "~56.0.5",
    "prettier": "^3.7.4",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
