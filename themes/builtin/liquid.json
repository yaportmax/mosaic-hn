{
  "manifest": {
    "id": "org.mosaichn.liquid",
    "name": "Liquid Glass",
    "author": "Mosaic HN",
    "version": "1.0.0",
    "minAppVersion": "1.0.0",
    "license": "MIT",
    "description": "Uses Apple Liquid Glass on supported iOS. Web and older devices use a blur-and-highlight fallback."
  },
  "tokens": {
    "light": {
      "colors": {
        "background": "#DFECFA",
        "surface": "#FFFFFF82",
        "text": "#0B1220",
        "mutedText": "#4B5D78",
        "accent": "#2668E8",
        "border": "#FFFFFFB8",
        "success": "#147D64",
        "warning": "#956300",
        "danger": "#C22F2F"
      },
      "typography": {
        "fontFamily": "system",
        "monoFamily": "monospace",
        "scale": 1,
        "titleWeight": "700",
        "bodyWeight": "400"
      },
      "spacing": {
        "unit": 4,
        "density": 1
      },
      "shape": {
        "radius": 22,
        "borderWidth": 1
      },
      "effects": {
        "glass": true,
        "blur": 28,
        "shadow": 0.18
      },
      "motion": {
        "durationScale": 1,
        "springDamping": 20
      }
    },
    "dark": {
      "colors": {
        "background": "#07101D",
        "surface": "#16305282",
        "text": "#F3F8FF",
        "mutedText": "#AFC1D8",
        "accent": "#80B6FF",
        "border": "#FFFFFF42",
        "success": "#42C69B",
        "warning": "#F5C05A",
        "danger": "#FF7C7C"
      },
      "typography": {
        "fontFamily": "system",
        "monoFamily": "monospace",
        "scale": 1,
        "titleWeight": "700",
        "bodyWeight": "400"
      },
      "spacing": {
        "unit": 4,
        "density": 1
      },
      "shape": {
        "radius": 22,
        "borderWidth": 1
      },
      "effects": {
        "glass": true,
        "blur": 34,
        "shadow": 0.34
      },
      "motion": {
        "durationScale": 1,
        "springDamping": 20
      }
    }
  },
  "layout": {
    "shell": "tabs",
    "feed": "cards",
    "story": "card",
    "comments": "conversation",
    "navigation": "standard",
    "metadata": "footer"
  }
}
